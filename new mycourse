def create_field(parent, label_text, placeholder):
    tk.Label(parent, text=label_text, font=("Arial", 11, "bold"), bg="white", fg="#334155", justify="center").pack(anchor="center", pady=(10,0))
    e = tk.Entry(parent, width=45, font=("Arial", 10), bg="#F1F5F9", fg="#334155", relief="flat", highlightthickness=1, highlightbackground="#E2E8F0", highlightcolor="#4F46E5", justify="center")
    e.pack(ipady=10, ipadx=10, pady=5)
    e.insert(0, placeholder)
    def on_in(event):
        if event.widget.get() == placeholder: event.widget.delete(0, 'end')
    def on_out(event):
        if not event.widget.get(): event.widget.insert(0, placeholder)
    e.bind("<FocusIn>", on_in)
    e.bind("<FocusOut>", on_out)
    return e

