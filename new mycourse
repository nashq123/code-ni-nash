def create_field(parent, label_text, placeholder):
    tk.Label(parent, text=label_text, font=("Arial", 10, "bold"), bg="white", fg="#334155").pack(anchor="center", pady=(5,0))
    e = tk.Entry(parent, width=40, font=("Arial", 10), bg="#F0FDF4", fg="#334155", relief="flat", highlightthickness=1, highlightbackground="#BBF7D0", highlightcolor="#026307", justify="center")
    e.pack(ipady=7, ipadx=10, pady=2, anchor="center")
    e.insert(0, placeholder)
    def on_in(event):
        if event.widget.get() == placeholder: event.widget.delete(0, 'end')
    def on_out(event):
        if not event.widget.get(): event.widget.insert(0, placeholder)
    e.bind("<FocusIn>", on_in)
    e.bind("<FocusOut>", on_out)
    return e
