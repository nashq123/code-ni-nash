import tkinter as tk
import sqlite3

def get_connection():
    return sqlite3.connect("mycourse.db")

def create_table():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("DROP TABLE IF EXISTS courses")
    cur.execute("""CREATE TABLE courses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        course_code TEXT NOT NULL,
        course_name TEXT NOT NULL,
        skills TEXT NOT NULL
    ) """)
    courses_data = [
        ("BSIT", "BS Information Technology", "coding, programming, computer, technology, code, math, programmer, it"),
        ("BSCS", "BS Computer Science", "coding, programming, ai, algorithm, software, math, code, programmer, computer"),
        ("BSEE", "BS Electrical Engineering", "electrical, kuryente, wiring, engineering"),
        ("BSBA", "BS Business Administration", "business, selling, marketing, negotiation, negosyo"),
        ("BSTM", "BS Tourism Management", "tourism, travel, gala, tour guide, airport, tour"),
        ("BSHM", "BS Hospitality Management", "cooking, cook, luto, hotel, chef, baking, food, pagluluto"),
        ("BSCRIM", "BS Criminology", "police, pulis, crime, investigation, criminology"),
        ("BSED", "BS Education", "teaching, turo, teacher, tutor, guro"),
        ("BSN", "BS Nursing", "clinical skills, anatomy, med knowledge, basic math, math, communication, emotional stability"),
        ("BSA", "BS Architecture", "drawing, guhit, 3d modeling, math, design, creativity,")
    ]
    cur.executemany("INSERT INTO courses (course_code, course_name, skills) VALUES (?,?,?)", courses_data)
    conn.commit()
    conn.close()

def suggest_course():
    name = entry_name.get().strip()
    strand = entry_strand.get().strip()
    # sa skills lang ako nag based hahaha
    skills_input = entry_skills.get().lower().strip()

    if not skills_input or skills_input == "type your skills here." or skills_input == "ex: coding, cooking, mag-turo":
        result_frame.place(relx=0.5, rely=0.95,anchor="center")
        result_label.config(text="Please fill up Skills!", anchor="center", fg="#E74C3C")
        return

    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT * FROM courses")
    all_courses = cur.fetchall()
    conn.close()

    # skills lang dito talaga
    user_skills = [k.strip() for k in skills_input.replace(',', '|').split('|') if len(k.strip()) >= 3]

    matched = []
    for course in all_courses:
        course_code, course_name, course_skills_str = course[1], course[2], course[3].lower()
        course_keywords = [k.strip() for k in course_skills_str.split(",")]
        score = 0
        found_keywords = []
        for u in user_skills:
            for c in course_keywords:
                if u == c or u in c.split() or c in u.split():
                    score += 1
                    if u not in found_keywords: found_keywords.append(u)
                    break
        if score > 0:
            matched.append((course_code, course_name, score, found_keywords))

    result_frame.place(relx=0.5, rely=0.82, anchor="center")
    if not matched:
        result_label.config(text=f"Hi {name}, No match found 😢", fg="#E74C3C")
        reason_label.config(text="Try: coding, cooking, business, tourism, etc.", fg="#7f8c8d")
    else:
        matched_sorted = sorted(matched, key=lambda x: x[2], reverse=True)
        best_courses = [f"✨ {m[0]} - {m[1]}" for m in matched_sorted]
        top_match = matched_sorted[0]
        result_label.config(text=f"Hi {name}! \n" + "\n".join(best_courses), fg="#2C3E50")
        reason_label.config(text=f"Suggested: {top_match[0]} because you're good at {', '.join(top_match[3])} | Strand: {strand}", fg="#27AE60")

